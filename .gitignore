# The dataset is distributed separately and never committed. Everything under
# data/ is ignored except the empty data/ElMo3D_data/ placeholder, so stray
# copies of the data elsewhere in data/ cannot be committed either.
data/*
!data/LICENSE
!data/ElMo3D_data/
data/ElMo3D_data/*
!data/ElMo3D_data/.gitkeep

# The SMPL-H body model is licensed separately (mano.is.tue.mpg.de); never
# commit it, wherever it is put
visualisation/body_models/
**/body_models/
*.pkl

# Builds written by build_dataset.py
dataset_build/*
!dataset_build/.gitkeep

# Python
__pycache__/
*.py[cod]

# ROM_ANOVA per-trial tables: regenerated by validation/ROM_ANOVA/extract_ROM.py.
# participant_rom.csv and ROM_ANOVA.csv stay committed.
validation/ROM_ANOVA/rom_*.csv
!validation/ROM_ANOVA/ROM_ANOVA.csv

*.pt

# LibreOffice lock files
.~lock.*#
